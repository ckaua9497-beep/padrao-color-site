# Copie para .env.local e preencha. O token nunca vai para o navegador: só o servidor do Next usa.

# Base da API Padrão Color (documentação: alteraçoes/DocumentacaoPadraoColor.pdf).
# Atenção: o host lab responde só em HTTPS.
PADRAO_API_URL=https://lab.padraocolor.com/site

# Bearer Token da integração (catálogo, cadastro de cliente e pedidos de quem ainda não tem token próprio).
PADRAO_API_TOKEN=

# Segredo para assinar o cookie de sessão do cliente logado (64+ caracteres aleatórios).
PADRAO_SESSION_SECRET=

# "true" envia o pedido de verdade (POST /gerarpedido). Qualquer outro valor = checkout em simulação:
# monta e mostra o payload sem criar pedido. Só ligue depois de validar o contrato de pedido com a Padrão.
PADRAO_ORDERS_ENABLED=false

# Opcional: origens extras aceitas nos POST (proxy que troca o Host), separadas por vírgula.
PADRAO_SITE_ORIGINS=

# Opcional: cabeçalho com o IP do cliente atrás de CDN (ex.: cf-connecting-ip, x-vercel-forwarded-for), usado
# nos limites de tentativas. Sem ele vale X-Real-IP ou o último X-Forwarded-For; IP interno não conta.
PADRAO_CLIENT_IP_HEADER=

# Produtos novos (API própria /api/novos). URL que o `npm run sync:novos` consome (padrão: o dev server local) e,
# se definido, o token exigido em "Authorization: Bearer <token>" para ler a API.
NOVOS_API_URL=
NOVOS_API_TOKEN=
