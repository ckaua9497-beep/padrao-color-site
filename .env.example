# Copie para .env.local e preencha. O token nunca vai para o navegador: só o servidor do Next usa.

# Base da API Padrão Color (documentação: alteraçoes/DocumentacaoPadraoColor.pdf).
# Atenção: o host lab responde só em HTTPS.
PADRAO_API_URL=https://lab.padraocolor.com/site

# Bearer Token da integração (catálogo, cadastro de cliente e pedidos de quem ainda não tem token próprio).
PADRAO_API_TOKEN=

# Segredo para assinar o cookie de sessão do cliente logado (64+ caracteres aleatórios).
PADRAO_SESSION_SECRET=

# "true" envia o pedido de verdade (POST /gerarpedido). Qualquer outro valor = checkout em simulação:
# monta e mostra o payload sem criar pedido. Só ligue depois de validar o contrato de pedido com a Padrão.
PADRAO_ORDERS_ENABLED=false

# Frete: cotação pela API de frete da Padrão (ela já cota no Melhor Envio com a conta e o CEP de despacho dela).
# Sem a chave, cada loja da multiloja cobra o frete fixo dela. Nunca coloque a chave em arquivo versionado.
PADRAO_FRETE_URL=https://padraocolor.com.br/api/v2/melhor-envio/freight/calculate
PADRAO_FRETE_API_KEY=
# Teste local sem chamar a API de verdade: node scripts/frete-mock.mjs (porta 3197) e, no .env.development.local,
# PADRAO_FRETE_URL=http://localhost:3197/api/v2/melhor-envio/freight/calculate e PADRAO_FRETE_API_KEY=teste.

# Bunny Storage: os arquivos de arte sobem para lá no checkout (PUT com a AccessKey, só no servidor) e o pedido leva a
# URL pública em produtos[].arte.anexos. Sem a chave, o checkout segue sem os arquivos (a arte vai depois).
# Nunca coloque a chave em arquivo versionado: só no .env.local do servidor.
BUNNY_ACCESS_KEY=
# Ex.: https://br.storage.bunnycdn.com/<zona> (escrita) e https://<zona>.b-cdn.net (leitura pública).
BUNNY_STORAGE_URL=
BUNNY_CDN_URL=
BUNNY_UPLOAD_FOLDER=uploads-clientes
# Teste local sem tocar no Bunny de verdade: node scripts/bunny-mock.mjs e, no .env.development.local,
# BUNNY_ACCESS_KEY=teste, BUNNY_STORAGE_URL=http://localhost:3196/padraocolor, BUNNY_CDN_URL=http://localhost:3196/cdn.

# Opcional: origens extras aceitas nos POST (proxy que troca o Host), separadas por vírgula.
PADRAO_SITE_ORIGINS=

# Opcional: cabeçalho com o IP do cliente atrás de CDN (ex.: cf-connecting-ip, x-vercel-forwarded-for), usado
# nos limites de tentativas. Sem ele vale X-Real-IP ou o último X-Forwarded-For; IP interno não conta.
PADRAO_CLIENT_IP_HEADER=

# Produtos novos (API própria /api/novos). URL que o `npm run sync:novos` consome (padrão: o dev server local) e,
# se definido, o token exigido em "Authorization: Bearer <token>" para ler a API.
NOVOS_API_URL=
NOVOS_API_TOKEN=

# Multiloja (lojas de influenciadores e fornecedores; README "Multiloja").
# Domínio das lojas: cada loja responde em <subdominio>.<MULTILOJA_DOMINIO> (precisa de DNS curinga *.dominio).
# Em desenvolvimento deixe vazio ("localhost"): a loja abre em http://<subdominio>.localhost:3100.
MULTILOJA_DOMINIO=
# Hosts do site principal que nunca viram loja (ex.: padraocolor.com.br,www.padraocolor.com.br).
MULTILOJA_HOSTS_PRINCIPAIS=
# Fator da tabela base do lojista sobre o preço de balcão do catálogo (1 = mesmo preço; 0,6 = 40% abaixo).
# Provisório até a Padrão definir a tabela da multiloja.
MULTILOJA_FATOR_BASE=1
# Banco da multiloja: PostgreSQL. Tudo fica nele: lojistas, lojas, pedidos, saques, configurações, rastreamento e
# os arquivos enviados (logos, banners e artes dos pedidos). Produção: a URL do Postgres na nuvem (Supabase, Neon,
# RDS…), com SSL, ex.: postgres://usuario:senha@host:5432/banco?sslmode=require (em hospedagem serverless, use a URL
# do "pooler"). Em desenvolvimento deixe vazio: `npm run dev` liga um Postgres local em .data/postgres (porta 5433).
DATABASE_URL=
# Só desenvolvimento: outra porta para o Postgres local; e liberar o banco local num `next start` de teste.
MULTILOJA_PG_PORTA=
MULTILOJA_BANCO_LOCAL=
# URL pública do site principal (webhooks de pagamento), ex.: https://www.padraocolor.com.br
MULTILOJA_URL_PUBLICA=
# Host para onde o domínio próprio do lojista aponta (CNAME). Vazio: a Padrão libera o domínio no /admin.
MULTILOJA_DNS_ALVO=

# Pagamento online das lojas (Pix, boleto e cartão). O normal é configurar tudo no /admin → Pagamentos: lá cada forma
# tem o seu gateway (ex.: Pix pela Pagar.me, cartão pela Cielo), e as chaves ficam cifradas no banco. Estas variáveis
# só valem enquanto o /admin não tiver nada salvo.
# Gateway de todas as formas: "efi", "cielo", "pagarme" (só Pix) ou "simulado" (teste; padrão em desenvolvimento).
# Em produção sem gateway configurado, os pedidos seguem pelo WhatsApp da loja.
MULTILOJA_PAGAMENTO=
# Credenciais da Efí (API Pix + API de Cobranças). O certificado .p12 é exigido pela API Pix.
# Testada contra o simulador local (scripts/efi-mock.mjs); validar com as credenciais de homologação antes de produção.
MULTILOJA_EFI_SANDBOX=true
MULTILOJA_EFI_CLIENT_ID=
MULTILOJA_EFI_CLIENT_SECRET=
# Certificado .p12 da Efí: caminho do arquivo OU o conteúdo em base64 (hospedagens sem arquivo). A Efí gera sem senha.
MULTILOJA_EFI_CERTIFICADO=
MULTILOJA_EFI_CERTIFICADO_BASE64=
MULTILOJA_EFI_CERTIFICADO_SENHA=
MULTILOJA_EFI_CHAVE_PIX=
# Segredo que vai na URL dos webhooks (?hmac=...), 24+ letras/números. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MULTILOJA_EFI_WEBHOOK_SEGREDO=
# IPs de onde a Efí manda os webhooks (documentação da Efí); vazio = não confere.
MULTILOJA_EFI_WEBHOOK_IPS=34.193.116.226
# Só desenvolvimento: aponta a integração para o simulador local (node scripts/efi-mock.mjs).
MULTILOJA_EFI_MOCK_URL=
# Cielo: API E-commerce 3.0 (Pix e boleto) + Link de Pagamento (cartão, página segura da Cielo, até 6x).
# Testada contra o simulador local (scripts/cielo-mock.mjs); validar no sandbox da Cielo antes de produção.
MULTILOJA_CIELO_SANDBOX=true
MULTILOJA_CIELO_MERCHANT_ID=
MULTILOJA_CIELO_MERCHANT_KEY=
# Banco do boleto como está habilitado na conta: Bradesco2 ou BancoDoBrasil3 (sandbox: Simulado).
MULTILOJA_CIELO_BOLETO_BANCO=
# Link de Pagamento (cartão). Sem ele a Cielo cobra só Pix e boleto. Não tem sandbox: use o Modo Teste da loja.
MULTILOJA_CIELO_CLIENT_ID=
MULTILOJA_CIELO_CLIENT_SECRET=
# Segredo dos avisos da Cielo (cabeçalho X-Multiloja-Segredo e ?hmac= no link), 24+ caracteres.
MULTILOJA_CIELO_WEBHOOK_SEGREDO=
# Só desenvolvimento: aponta a integração para o simulador local (node scripts/cielo-mock.mjs).
MULTILOJA_CIELO_MOCK_URL=
# Pagar.me (Pix pela API v5). Chave SECRETA: sk_test_… usa o simulador da Pagar.me (Pix de até R$ 500 é pago sozinho);
# sk_… cobra de verdade. A URL do webhook (com o segredo) aparece no /admin → Pagamentos para cadastrar no painel dela.
MULTILOJA_PAGARME_CHAVE_SECRETA=
# Segredo dos avisos (?hmac= na URL do webhook ou senha da autenticação básica), 24+ caracteres.
MULTILOJA_PAGARME_WEBHOOK_SEGREDO=
# Só desenvolvimento: aponta a integração para o simulador local (node scripts/pagarme-mock.mjs, porta 3195).
MULTILOJA_PAGARME_MOCK_URL=
# Taxas de cada meio, descontadas da comissão do lojista (o /admin → Pagamentos também tem % + valor fixo).
# Pix e cartão em % do valor pago; boleto em R$ por boleto pago. Provisório até a Padrão definir.
MULTILOJA_TAXA_PIX=0
MULTILOJA_TAXA_BOLETO=0
MULTILOJA_TAXA_CARTAO=0
# Dias depois do pagamento para a comissão ficar disponível mesmo sem a entrega marcada.
MULTILOJA_DIAS_LIBERACAO=14
# Cliente da Padrão em nome de quem os pedidos pagos vão para a produção (POST /gerarpedido).
# Só envia de verdade com PADRAO_ORDERS_ENABLED=true; senão o /admin simula e mostra os dados.
PADRAO_MULTILOJA_CLIENTE_ID=
