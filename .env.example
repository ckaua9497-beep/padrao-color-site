# Copie para .env.local e preencha. O token nunca vai para o navegador: só o servidor do Next usa.

# Base da API Padrão Color (documentação: alteraçoes/DocumentacaoPadraoColor.pdf).
# Atenção: o host lab responde só em HTTPS.
PADRAO_API_URL=https://lab.padraocolor.com/site

# Bearer Token da integração (catálogo, cadastro de cliente e pedidos de quem ainda não tem token próprio).
PADRAO_API_TOKEN=

# Segredo para assinar o cookie de sessão do cliente logado (64+ caracteres aleatórios).
PADRAO_SESSION_SECRET=

# "true" envia o pedido de verdade (POST /gerarpedido). Qualquer outro valor = checkout em simulação:
# monta e mostra o payload sem criar pedido. Só ligue depois de validar o contrato de pedido com a Padrão.
PADRAO_ORDERS_ENABLED=false

# Opcional: origens extras aceitas nos POST (proxy que troca o Host), separadas por vírgula.
PADRAO_SITE_ORIGINS=

# Opcional: cabeçalho com o IP do cliente atrás de CDN (ex.: cf-connecting-ip, x-vercel-forwarded-for), usado
# nos limites de tentativas. Sem ele vale X-Real-IP ou o último X-Forwarded-For; IP interno não conta.
PADRAO_CLIENT_IP_HEADER=

# Produtos novos (API própria /api/novos). URL que o `npm run sync:novos` consome (padrão: o dev server local) e,
# se definido, o token exigido em "Authorization: Bearer <token>" para ler a API.
NOVOS_API_URL=
NOVOS_API_TOKEN=

# Multiloja (lojas de influenciadores e fornecedores; README "Multiloja").
# Domínio das lojas: cada loja responde em <subdominio>.<MULTILOJA_DOMINIO> (precisa de DNS curinga *.dominio).
# Em desenvolvimento deixe vazio ("localhost"): a loja abre em http://<subdominio>.localhost:3100.
MULTILOJA_DOMINIO=
# Hosts do site principal que nunca viram loja (ex.: padraocolor.com.br,www.padraocolor.com.br).
MULTILOJA_HOSTS_PRINCIPAIS=
# Fator da tabela base do lojista sobre o preço de balcão do catálogo (1 = mesmo preço; 0,6 = 40% abaixo).
# Provisório até a Padrão definir a tabela da multiloja.
MULTILOJA_FATOR_BASE=1
# Banco SQLite e pasta das imagens e artes enviadas (padrão: .data/).
MULTILOJA_DB=
MULTILOJA_ARQUIVOS=
# URL pública do site principal (webhooks de pagamento), ex.: https://www.padraocolor.com.br
MULTILOJA_URL_PUBLICA=
# Host para onde o domínio próprio do lojista aponta (CNAME). Vazio: a Padrão libera o domínio no /admin.
MULTILOJA_DNS_ALVO=

# Pagamento online das lojas: "efi" (real) ou "simulado" (teste; padrão em desenvolvimento).
# Em produção sem "efi" configurado, os pedidos seguem pelo WhatsApp da loja.
MULTILOJA_PAGAMENTO=
# Credenciais da Efí (API Pix + API de Cobranças). O certificado .p12 é exigido pela API Pix.
# Testada contra o simulador local (scripts/efi-mock.mjs); validar com as credenciais de homologação antes de produção.
MULTILOJA_EFI_SANDBOX=true
MULTILOJA_EFI_CLIENT_ID=
MULTILOJA_EFI_CLIENT_SECRET=
# Certificado .p12 da Efí: caminho do arquivo OU o conteúdo em base64 (hospedagens sem arquivo). A Efí gera sem senha.
MULTILOJA_EFI_CERTIFICADO=
MULTILOJA_EFI_CERTIFICADO_BASE64=
MULTILOJA_EFI_CERTIFICADO_SENHA=
MULTILOJA_EFI_CHAVE_PIX=
# Segredo que vai na URL dos webhooks (?hmac=...), 24+ letras/números. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MULTILOJA_EFI_WEBHOOK_SEGREDO=
# IPs de onde a Efí manda os webhooks (documentação da Efí); vazio = não confere.
MULTILOJA_EFI_WEBHOOK_IPS=34.193.116.226
# Só desenvolvimento: aponta a integração para o simulador local (node scripts/efi-mock.mjs).
MULTILOJA_EFI_MOCK_URL=
# Taxas de cada meio (% do valor pago), descontadas da comissão do lojista. Provisório até a Padrão definir.
MULTILOJA_TAXA_PIX=0
MULTILOJA_TAXA_CARTAO=0
# Dias depois do pagamento para a comissão ficar disponível mesmo sem a entrega marcada.
MULTILOJA_DIAS_LIBERACAO=14
# Cliente da Padrão em nome de quem os pedidos pagos vão para a produção (POST /gerarpedido).
# Só envia de verdade com PADRAO_ORDERS_ENABLED=true; senão o /admin simula e mostra os dados.
PADRAO_MULTILOJA_CLIENTE_ID=
